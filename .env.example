# 飞书客户端：mock（默认）| real。模型可单独保留 mock。
CLIENT_MODE=mock
MODEL_MODE=mock

# HTTP
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# real 模式的入口身份。每项 key 至少 24 字符；仅从环境注入，不能提交真实值。
# 格式示例（部署时替换占位 key）
# API_ACTORS_JSON=[{"key":"replace-with-long-random-secret","operator":"user:alice","spaces":["space_sales"],"can_run_summary":false,"finance":false}]
# 员工 WorkBuddy 独立凭证示例：kind=employee，并在服务端固定员工、部门、空间和密级；不要与管理员共用 key。
# {"key":"replace-with-another-long-random-secret","kind":"employee","operator":"finance:hyh","employee":"hyh","department":"财务","spaces":["space_finance_test"],"default_space_id":"space_finance_test","default_confidentiality":"finance","can_run_summary":false,"finance":true}
API_ACTORS_JSON=

# 飞书工作台管理员网页：上线前需配置 HTTPS 网页入口和飞书登录身份白名单。
# open_id 必须来自当前测试应用的登录回调；权限与 API 身份独立配置。
ADMIN_WEB_ENABLED=false
# ADMIN_WEB_ACTORS_JSON=[{"open_id":"ou_replace","operator":"admin:example","spaces":["space_public_test","space_finance_test"],"can_run_summary":true,"finance":true}]
ADMIN_WEB_ACTORS_JSON=
# 至少 32 字符随机值，仅保存在服务端；更换后旧网页登录态失效。
ADMIN_WEB_SESSION_SECRET=

# 飞书应用（仅 real 模式需要；切勿提交真实值）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# space_id -> folder_token。每个空间单独映射。
FEISHU_FOLDER_MAP_JSON=
# 包含 {file_id} 的租户文件访问链接模板，联调时确认实际格式。
FEISHU_FILE_URL_TEMPLATE=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_LEDGER_TABLE_ID=
FEISHU_DAILY_TABLE_ID=
FEISHU_EXPECTED_TABLE_ID=
FEISHU_SUMMARY_TABLE_ID=
FEISHU_JOB_TABLE_ID=
FEISHU_AUDIT_TABLE_ID=
FEISHU_MANAGER_CHAT_ID=

# 财务测试空间（业务层权限校验）
FEISHU_FINANCE_SPACE_ID=space_finance_test

# 虚构日报种子写入开关；只可在独立测试租户临时设为 true
FEISHU_TEST_SEED_ALLOWED=false

# 模型（仅 MODEL_MODE=real 时需要密钥）。DeepSeek 选项：
# MODEL_PROVIDER=deepseek
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 持久化发送/上传回执与跨进程锁；真实部署必须使用持久磁盘。
STATE_DB_PATH=./data/state.db

# MCP stdio 使用 API_ACTORS_JSON 中的一个 key（通过进程环境注入）
MCP_API_KEY=

# 调度（Asia/Shanghai 每天 20:00；mock 下可用手动 API）
DAILY_CRON_ENABLED=false
TZ=Asia/Shanghai

# Wiki extension: disabled until scopes, space membership and target IDs have been verified.
WIKI_ENABLED=false
# Example shape (replace every placeholder; staging_space_id must map to a dedicated folder
# in FEISHU_FOLDER_MAP_JSON; never reuse the finance folder).
# FEISHU_WIKI_TARGETS_JSON=[{"id":"public_demo","name":"虚构测试知识库","space_id":"SPACE_ID","parent_node_token":"HOME_NODE","staging_space_id":"wiki_staging","url_origin":"https://TENANT.feishu.cn"}]
FEISHU_WIKI_TARGETS_JSON=[]
# Add wiki_read_targets:["public_demo"] and/or wiki_write_targets:["public_demo"]
# ONLY to approved entries of API_ACTORS_JSON. Existing finance rights grant no Wiki rights.
