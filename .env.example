# 客户端模式：mock（默认，无真实飞书/模型）| real（凭证就绪后）
CLIENT_MODE=mock

# HTTP
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# real 模式的入口身份。每项 key 至少 24 字符；仅从环境注入，不能提交真实值。
# 格式示例（部署时替换占位 key）
# API_ACTORS_JSON=[{"key":"replace-with-long-random-secret","operator":"user:alice","spaces":["space_sales"],"can_run_summary":false,"finance":false}]
API_ACTORS_JSON=

# 飞书应用（仅 real 模式需要；切勿提交真实值）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DEFAULT_FOLDER_TOKEN=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_LEDGER_TABLE_ID=
FEISHU_DAILY_TABLE_ID=
FEISHU_SUMMARY_TABLE_ID=
FEISHU_JOB_TABLE_ID=
FEISHU_MANAGER_CHAT_ID=

# 财务测试空间（业务层权限校验）
FEISHU_FINANCE_SPACE_ID=space_finance_test

# 模型（仅 real 模式需要）
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 调度（Asia/Shanghai 每天 20:00；mock 下可用手动 API）
DAILY_CRON_ENABLED=false
TZ=Asia/Shanghai
