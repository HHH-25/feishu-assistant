# Copy needed entries into .env.local. Never commit secrets or personal tokens.
MCP_PORT=3010
MCP_PUBLIC_URL=https://your-mcp-host.example.com
MCP_STATE_DB_PATH=./data/bridge.db
FEISHU_APP_ID=
FEISHU_APP_SECRET=
MCP_FEISHU_TENANT_KEY=
# Company deployment: tenant admits users who complete this app's Feishu OAuth
# and belong to MCP_FEISHU_TENANT_KEY. Resource and user permissions still apply.
# Default when omitted: allowlist (requires MCP_ALLOWED_USERS_JSON).
MCP_ACCESS_MODE=tenant
# Discover wiki spaces and joined chats using each employee's user access token.
# Tables and direct-message recipients still use the explicit configuration below.
MCP_RESOURCE_MODE=user
MCP_ALLOWED_USERS_JSON=[]
# Identifiers must come from the same Feishu app/organization.
# The space is the allowlist boundary; parent_node_token is the default creation location.
FEISHU_WIKI_TARGETS_JSON=[]
# Example target: {"id":"team","name":"Team wiki","space_id":"SPACE","parent_node_token":"NODE","url_origin":"https://YOUR.feishu.cn","staging_folder_token":"FOLDER"}
MCP_CHATS_JSON=[]
# Example chat: {"id":"test_group","name":"Test group","chat_id":"oc_xxx"}
MCP_TABLES_JSON=[]
# Example table: {"id":"customers","name":"Test customers","app_token":"BASE","table_id":"TABLE"}
MCP_RECIPIENTS_JSON=[]
# Example recipient: {"id":"tester","name":"Tester","open_id":"ou_receiver","allowed_senders":["ou_sender"]}
