{
  "name": "feishu-enterprise-datacenter-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "ChatGPT 飞书助手：个人授权、知识库、消息与多维表格",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
