    "jose": "^6.2.13",
    "multer": "2.5.0",
    "oidc-provider": "^9.13.0",
    "undici": "^7.30.1",
    "uuid": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/oidc-provider": "^9.12.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
