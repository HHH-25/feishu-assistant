{
  "mcpServers": {
    "feishu-datacenter-employee": {
      "type": "stdio",
      "command": "node",
      "args": ["__ABSOLUTE_SERVER_JS__"],
      "env": {
        "MVP_EMPLOYEE_TOKEN": "${MVP_EMPLOYEE_TOKEN}",
        "MVP_BASE_URL": "${MVP_BASE_URL}",
        "MVP_UPLOAD_ROOT": "${MVP_UPLOAD_ROOT}"
      },
      "timeout": 30000
    }
  }
}
